{
  "name": "imap-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Read + draft MCP server for a Mailcow IMAP mailbox, exposed to claude.ai over OAuth 2.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "hash-password": "node dist/tools/hash-password.js",
    "test:auth": "node test/auth.mjs",
    "test:smoke": "node test/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "5.2.1",
    "imapflow": "2.0.5",
    "jose": "6.2.12",
    "mailparser": "3.9.28",
    "nodemailer": "^10.0.10",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
