# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Hostname Traefik routes to this container (used by the compose labels).
MCP_HOST=mail-mcp.example.be

# Canonical URI of this MCP server, exactly as claude.ai will address it.
# This is the OAuth resource indicator and the JWT audience: if it does not
# match what the client asks for, tokens are refused. No trailing slash.
MCP_RESOURCE_URL=https://mail-mcp.example.be/mcp

# OAuth issuer. Same origin as above, without the /mcp path.
OAUTH_ISSUER_URL=https://mail-mcp.example.be

PORT=8080
STATE_DIR=/data

# --- Operator login (the human who authorizes the connector) ---------------
OPERATOR_USERNAME=gert
# Generate with:  docker compose run --rm imap-mcp node dist/tools/hash-password.js
OPERATOR_PASSWORD_HASH=

# --- Token signing ---------------------------------------------------------
# openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000

# --- IMAP (Mailcow on Aether, over the private subnet) ---------------------
IMAP_HOST=aether.internal
IMAP_PORT=993
IMAP_SECURE=true
# Leave true. Only consider false if Aether's cert does not cover the private
# name you connect to — and prefer fixing the cert instead.
IMAP_TLS_REJECT_UNAUTHORIZED=true
IMAP_USER=gert@stormlabs.be
IMAP_PASSWORD=
IMAP_DRAFTS_FOLDER=Drafts

# --- Guard rails -----------------------------------------------------------
MAX_SEARCH_RESULTS=50
MAX_BODY_CHARS=20000
# Comma-separated allowlist. Empty means every folder is readable.
ALLOWED_FOLDERS=INBOX,Sent,Drafts,Archive
# Set false to drop create_draft and make the server strictly read-only.
ENABLE_DRAFTS=true
