# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Hostname Traefik routes to this container (used by the compose labels).
MCP_HOST=mail-mcp.example.be

# Canonical URI of this MCP server, exactly as claude.ai will address it.
# This is the OAuth resource indicator and the JWT audience: if it does not
# match what the client asks for, tokens are refused. No trailing slash.
MCP_RESOURCE_URL=https://mail-mcp.example.be/mcp

# OAuth issuer. Same origin as above, without the /mcp path.
OAUTH_ISSUER_URL=https://mail-mcp.example.be

PORT=8080
STATE_DIR=/data

# --- Operator login (the human who authorizes the connector) ---------------
# One person with every mailbox. To have several people, each with their own
# mailboxes, list them under users: in mailboxes.yml and remove these two.
OPERATOR_USERNAME=operator
# Generate with:  docker compose run --rm imap-mcp node dist/tools/hash-password.js
OPERATOR_PASSWORD_HASH=
# With users: in mailboxes.yml, one hash per user instead, named by its passwordHashEnv:
# PASSWORD_HASH_GERT=
# PASSWORD_HASH_ANNA=

# --- Token signing ---------------------------------------------------------
# openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000

# --- Mailboxes -------------------------------------------------------------
# The mailboxes, one or many, are described in mailboxes.yml (see
# mailboxes.example.yml), which the compose file mounts. Each mailbox's app
# password goes in the variable its entry names, e.g. IMAP_PASSWORD_INFO.
IMAP_PASSWORD_PERSONAL=
# IMAP_PASSWORD_INFO=
# IMAP_PASSWORD_AGENT=

# --- IMAP (Mailcow, over the private subnet) --------------------------------
# Host and TLS settings are shared by every mailbox.
IMAP_HOST=mail.internal
IMAP_PORT=993
IMAP_SECURE=true
# Leave true. Only consider false if your mail server's cert does not cover the private
# name you connect to — and prefer fixing the cert instead.
IMAP_TLS_REJECT_UNAUTHORIZED=true
IMAP_DRAFTS_FOLDER=Drafts
IMAP_SENT_FOLDER=Sent

# --- SMTP submission --------------------------------------------------------
# Only used by mailboxes whose mailboxes.yml entry has the "send" capability.
# 465 with SMTP_SECURE=true, or 587 with SMTP_SECURE=false (STARTTLS).
# SMTP_HOST=mail.internal
SMTP_PORT=465
SMTP_SECURE=true
SMTP_TLS_REJECT_UNAUTHORIZED=true

# --- Guard rails -----------------------------------------------------------
MAX_SEARCH_RESULTS=50
MAX_BODY_CHARS=20000
# Comma-separated allowlist. Empty means every folder is readable.
ALLOWED_FOLDERS=INBOX,Sent,Drafts,Archive
# Set false to drop create_draft (and the mail:draft scope).
ENABLE_DRAFTS=true
# Set false to drop mark_messages (read/unread, flag) and the mail:mark scope.
ENABLE_MARKING=true
# Set false to drop move_messages and the mail:move scope.
ENABLE_MOVE=true
# Kill switch: false drops send_draft everywhere, whatever mailboxes.yml says.
ENABLE_SEND=true
